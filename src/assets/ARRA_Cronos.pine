//@version=6
indicator("ARRA Cronos · All-Timeframe Signals", overlay=true, max_lines_count=100, max_labels_count=100, max_bars_back=500)

const int fastLength = 9
const int signalLength = 21
const int slowLength = 55
const int rsiLength = 14
const int atrLength = 14
showDashboard = input.bool(true, "Tampilkan ringkasan")
showForecast = input.bool(true, "Tampilkan jalur forecast & koridor")
showLevels = input.bool(true, "Tampilkan ENTRY / SL / TP")

forecastBars = timeframe.isdaily ? 7 : 12
is15m = timeframe.isminutes and timeframe.multiplier == 15
is1h = timeframe.isminutes and timeframe.multiplier == 60
is4h = timeframe.isminutes and timeframe.multiplier == 240
is1d = timeframe.isdaily and timeframe.multiplier == 1
chartSeconds = timeframe.in_seconds()
confirmationTimeframe1 = chartSeconds < 900 ? "15" : chartSeconds < 3600 ? "60" : chartSeconds < 14400 ? "240" : chartSeconds < 86400 ? "D" : chartSeconds < 604800 ? "W" : chartSeconds < 2592000 ? "M" : chartSeconds < 7776000 ? "3M" : "12M"
confirmationTimeframe2 = confirmationTimeframe1 == "15" ? "60" : confirmationTimeframe1 == "60" ? "240" : confirmationTimeframe1 == "240" ? "D" : confirmationTimeframe1 == "D" ? "W" : confirmationTimeframe1 == "W" ? "M" : confirmationTimeframe1 == "M" ? "3M" : "12M"
hasHigherConfirmation = not na(chartSeconds) and chartSeconds < 31536000

// Match the backend EMA initialization window: 2x period for the chart
// timeframe and 3x period for higher-timeframe confirmation.
f_engine_ema(source, period, sampleMultiplier) =>
    sampleLength = math.min(bar_index + 1, period * sampleMultiplier)
    alpha = 2.0 / (period + 1.0)
    float result = source[sampleLength - 1]
    if sampleLength > 1
        for step = 0 to sampleLength - 2
            offset = sampleLength - 2 - step
            result := source[offset] * alpha + result * (1.0 - alpha)
    result

f_engine_round(value, factor) => math.round(value * factor) / factor

f_engine_price_decimals() =>
    tickerId = str.upper(syminfo.tickerid)
    ticker = str.upper(syminfo.ticker)
    str.contains(tickerId, "XAU") ? 2 : str.contains(tickerId, "XAG") ? 3 : str.contains(tickerId, "JPY") ? 3 : str.contains(tickerId, "BTC") or str.contains(tickerId, "ETH") ? 2 : 5

enginePriceFactor = math.pow(10.0, f_engine_price_decimals())
emaFast = f_engine_ema(close, fastLength, 2)
emaSignal = f_engine_ema(close, signalLength, 2)
emaSlow = f_engine_ema(close, slowLength, 2)
trueRangeValue = ta.tr(true)
atrValue = ta.sma(trueRangeValue, atrLength)
gain = ta.sma(math.max(ta.change(close), 0.0), rsiLength)
loss = ta.sma(math.max(-ta.change(close), 0.0), rsiLength)
rsiValue = loss == 0 ? (gain == 0 ? 50.0 : 100.0) : 100.0 - 100.0 / (1.0 + gain / loss)
momentumReference = close[10]
momentumPct = not na(momentumReference) and momentumReference != 0 ? (close - momentumReference) / momentumReference * 100.0 : 0.0
priorAtr = ta.sma(trueRangeValue[atrLength], 36)
atrRatio = priorAtr != 0 and not na(priorAtr) ? atrValue / priorAtr : 1.0

f_mtf_bias(float tolerance) =>
    fast = f_engine_ema(close, fastLength, 3)
    signal = f_engine_ema(close, signalLength, 3)
    bar_index < 21 ? na : fast > signal * (1.0 + tolerance) ? 1 : fast < signal * (1.0 - tolerance) ? -1 : 0

f_auto_mtf_bias() =>
    contextSeconds = timeframe.in_seconds()
    contextTolerance = contextSeconds <= 900 ? 0.0003 : contextSeconds <= 3600 ? 0.0005 : contextSeconds <= 14400 ? 0.0008 : 0.001
    f_mtf_bias(contextTolerance)

// Higher-timeframe reads use only the previous completed candle. The chart
// timeframe itself is evaluated only when its candle closes.
hourBiasPrevious = request.security(syminfo.tickerid, "60", f_mtf_bias(0.0005)[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
hourBiasCurrent = request.security(syminfo.tickerid, "60", f_mtf_bias(0.0005), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
fourHourBiasPrevious = request.security(syminfo.tickerid, "240", f_mtf_bias(0.0008)[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
fourHourBiasCurrent = request.security(syminfo.tickerid, "240", f_mtf_bias(0.0008), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
dailyBiasPrevious = request.security(syminfo.tickerid, "D", f_mtf_bias(0.001)[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
dailyBiasCurrent = request.security(syminfo.tickerid, "D", f_mtf_bias(0.001), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
confirmedHourBias = time_close == time_close("60") ? hourBiasCurrent : hourBiasPrevious
confirmedFourHourBias = time_close == time_close("240") ? fourHourBiasCurrent : fourHourBiasPrevious
confirmedDailyBias = time_close == time_close("D") ? dailyBiasCurrent : dailyBiasPrevious
genericFirstPrevious = hasHigherConfirmation ? request.security(syminfo.tickerid, confirmationTimeframe1, f_auto_mtf_bias()[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on) : na
genericSecondPrevious = hasHigherConfirmation ? request.security(syminfo.tickerid, confirmationTimeframe2, f_auto_mtf_bias()[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on) : na
genericFirstBias = genericFirstPrevious
genericSecondBias = genericSecondPrevious
// request.security() is safe on every chart timeframe; on a daily chart it
// returns the last 4H intrabar, which is used only when the daily candle closes.
dailyFourHourBias = request.security(syminfo.tickerid, "240", f_mtf_bias(0.0008), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
chartTolerance = chartSeconds <= 900 ? 0.0003 : chartSeconds <= 3600 ? 0.0005 : chartSeconds <= 14400 ? 0.0008 : 0.001
chartBias = emaFast > emaSignal * (1.0 + chartTolerance) ? 1 : emaFast < emaSignal * (1.0 - chartTolerance) ? -1 : 0
allBullish = is15m ? chartBias == 1 and confirmedHourBias == 1 and confirmedFourHourBias == 1 : is1h ? chartBias == 1 and confirmedFourHourBias == 1 and confirmedDailyBias == 1 : is4h ? chartBias == 1 and confirmedDailyBias == 1 : is1d ? chartBias == 1 and dailyFourHourBias == 1 : chartBias == 1 and (not hasHigherConfirmation or genericFirstBias == 1) and (not hasHigherConfirmation or genericSecondBias == 1)
allBearish = is15m ? chartBias == -1 and confirmedHourBias == -1 and confirmedFourHourBias == -1 : is1h ? chartBias == -1 and confirmedFourHourBias == -1 and confirmedDailyBias == -1 : is4h ? chartBias == -1 and confirmedDailyBias == -1 : is1d ? chartBias == -1 and dailyFourHourBias == -1 : chartBias == -1 and (not hasHigherConfirmation or genericFirstBias == -1) and (not hasHigherConfirmation or genericSecondBias == -1)

rawTrend = atrValue > 0 ? ((close - emaSignal) / atrValue) * 0.4 + ((emaFast - emaSignal) / atrValue) * 0.35 + ((emaSignal - emaSlow) / atrValue) * 0.25 : 0.0
trendScore = math.round(math.max(-1.8, math.min(1.8, rawTrend)) / 1.8 * 100.0)
volatilityRegime = atrRatio < 0.85 ? "COMPRESSION" : atrRatio > 1.25 ? "EXPANSION" : "NORMAL"

var int setupSide = 0
var int setupBar = na
var float lockedEntry = na
var float lockedStop = na
var float lockedTp1 = na
var float lockedTp2 = na
var float lockedRR = na
var int lockedHorizon = na
var int setupStatus = 0 // 0 none, 1 open, 2 TP1, 3 TP2, -1 SL, -2 SL after TP1, 4 ambiguous, 5 ambiguous after TP1, 6 expired, 7 expired after TP1
var array<line> previewLines = array.new_line()
var array<line> previewLevelLines = array.new_line()
var array<line> latestSetupLines = array.new_line()
var array<label> latestSetupLabels = array.new_label()
var label previewEntryLabel = na
var label statusEventLabel = na

// Save flags before evaluating this candle. Cronos does not open a replacement
// setup on the same candle that closes the previous one.
hadActiveSetup = setupStatus == 1 or setupStatus == 2
tp1Event = false
tp2Event = false
slEvent = false
ambiguousEvent = false

if hadActiveSetup and barstate.isconfirmed and bar_index > setupBar
    if bar_index - setupBar > lockedHorizon
        setupStatus := setupStatus == 2 ? 7 : 6
    else
        hitStop = setupSide == 1 ? low <= lockedStop : high >= lockedStop
        hitTp1 = setupStatus == 1 and (setupSide == 1 ? high >= lockedTp1 : low <= lockedTp1)
        hitTp2 = setupSide == 1 ? high >= lockedTp2 : low <= lockedTp2
        if hitStop and (hitTp1 or hitTp2)
            setupStatus := setupStatus == 2 ? 5 : 4
            ambiguousEvent := true
        else if hitStop
            setupStatus := setupStatus == 2 ? -2 : -1
            slEvent := true
        else if hitTp2
            setupStatus := 3
            tp1Event := hitTp1
            tp2Event := true
        else if hitTp1
            setupStatus := 2
            tp1Event := true

forecast = array.new_float()
forecastUpper = array.new_float()
forecastLower = array.new_float()
projected = close
forecastSign = math.sign(trendScore != 0 ? trendScore : momentumPct != 0 ? momentumPct : 1.0)
for step = 1 to forecastBars
    drift = (trendScore / 100.0) * atrValue * 0.24 * math.exp(-0.06 * (step - 1))
    cycle = math.sin((step / forecastBars) * math.pi) * atrValue * 0.035 * forecastSign
    projected := math.max(projected * 0.1, projected + drift + cycle)
    dispersion = atrValue * math.sqrt(step) * 0.48
    array.push(forecast, f_engine_round(projected, enginePriceFactor))
    array.push(forecastUpper, f_engine_round(projected + dispersion, enginePriceFactor))
    array.push(forecastLower, f_engine_round(projected - dispersion, enginePriceFactor))

forecastTarget = array.get(forecast, forecastBars - 1)
netMove = forecastTarget - close
forecastDirection = math.abs(netMove) >= atrValue * 0.18 ? (netMove > 0 ? 1 : -1) : 0
stopDistance = math.max(atrValue * 1.35, close * 0.001)
forecastRR = stopDistance > 0 ? math.abs(netMove) / stopDistance : 0.0
forecastSide = netMove < 0 or (netMove == 0 and trendScore < 0) ? -1 : 1
candidateBuy = barstate.isconfirmed and not na(atrValue) and not na(rsiValue) and forecastDirection == 1 and trendScore >= 15 and allBullish and rsiValue < 70
candidateSell = barstate.isconfirmed and not na(atrValue) and not na(rsiValue) and forecastDirection == -1 and trendScore <= -15 and allBearish and rsiValue > 30
openedBuy = not hadActiveSetup and candidateBuy
openedSell = not hadActiveSetup and candidateSell
newSetup = openedBuy or openedSell

if newSetup
    if not na(statusEventLabel)
        label.delete(statusEventLabel)
        statusEventLabel := na
    if array.size(latestSetupLines) > 0
        for i = 0 to array.size(latestSetupLines) - 1
            line.delete(array.get(latestSetupLines, i))
    array.clear(latestSetupLines)
    if array.size(latestSetupLabels) > 0
        for i = 0 to array.size(latestSetupLabels) - 1
            label.delete(array.get(latestSetupLabels, i))
    array.clear(latestSetupLabels)
    setupSide := openedBuy ? 1 : -1
    setupBar := bar_index
    lockedEntry := f_engine_round(close, enginePriceFactor)
    lockedHorizon := forecastBars
    lockedStop := f_engine_round(close - setupSide * stopDistance, enginePriceFactor)
    lockedTp1 := f_engine_round(close + setupSide * math.abs(netMove) * 0.55, enginePriceFactor)
    lockedTp2 := forecastTarget
    lockedRR := math.round(forecastRR * 100.0) / 100.0
    setupStatus := 1

    if array.size(previewLines) > 0
        for i = 0 to array.size(previewLines) - 1
            line.delete(array.get(previewLines, i))
    array.clear(previewLines)
    if array.size(previewLevelLines) > 0
        for i = 0 to array.size(previewLevelLines) - 1
            line.delete(array.get(previewLevelLines, i))
    array.clear(previewLevelLines)
    if not na(previewEntryLabel)
        label.delete(previewEntryLabel)
        previewEntryLabel := na

    // Draw the projection that existed at setup time.
    // Only the newest setup is kept visible; older setup drawings are removed.
    array.push(latestSetupLabels, label.new(bar_index, setupSide == 1 ? low : high, setupSide == 1 ? "BUY" : "SELL", xloc=xloc.bar_index, style=setupSide == 1 ? label.style_label_up : label.style_label_down, color=setupSide == 1 ? color.green : color.red, textcolor=color.white, size=size.small))
    if showForecast
        prevX = bar_index + 1
        prevMid = lockedEntry
        prevUpper = lockedEntry
        prevLower = lockedEntry
        for step = 1 to forecastBars
            nextMid = array.get(forecast, step - 1)
            nextUpper = array.get(forecastUpper, step - 1)
            nextLower = array.get(forecastLower, step - 1)
            nextX = bar_index + step + 1
            array.push(latestSetupLines, line.new(prevX, prevMid, nextX, nextMid, xloc=xloc.bar_index, color=color.aqua, width=3))
            array.push(latestSetupLines, line.new(prevX, prevUpper, nextX, nextUpper, xloc=xloc.bar_index, color=color.new(color.aqua, 58), style=line.style_dashed, width=1))
            array.push(latestSetupLines, line.new(prevX, prevLower, nextX, nextLower, xloc=xloc.bar_index, color=color.new(color.aqua, 58), style=line.style_dashed, width=1))
            array.push(latestSetupLabels, label.new(nextX, nextMid, "·", xloc=xloc.bar_index, style=label.style_none, textcolor=color.aqua, size=size.large))
            prevX := nextX
            prevMid := nextMid
            prevUpper := nextUpper
            prevLower := nextLower
    if showLevels
        array.push(latestSetupLines, line.new(bar_index, lockedEntry, bar_index + lockedHorizon + 1, lockedEntry, xloc=xloc.bar_index, color=color.blue, style=line.style_dashed, width=2))
        array.push(latestSetupLines, line.new(bar_index, lockedStop, bar_index + lockedHorizon + 1, lockedStop, xloc=xloc.bar_index, color=color.red, style=line.style_dashed, width=2))
        array.push(latestSetupLines, line.new(bar_index, lockedTp1, bar_index + lockedHorizon + 1, lockedTp1, xloc=xloc.bar_index, color=color.lime, style=line.style_dashed, width=1))
        array.push(latestSetupLines, line.new(bar_index, lockedTp2, bar_index + lockedHorizon + 1, lockedTp2, xloc=xloc.bar_index, color=color.green, style=line.style_dashed, width=2))
        array.push(latestSetupLabels, label.new(bar_index + 1, lockedEntry, (setupSide == 1 ? "BUY" : "SELL") + " ENTRY · " + str.tostring(lockedEntry, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=color.blue, textcolor=color.white, size=size.tiny))
        array.push(latestSetupLabels, label.new(bar_index + 1, lockedStop, "SL · " + str.tostring(lockedStop, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=color.red, textcolor=color.white, size=size.tiny))
        array.push(latestSetupLabels, label.new(bar_index + 1, lockedTp1, "TP1 · " + str.tostring(lockedTp1, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=color.green, textcolor=color.white, size=size.tiny))
        array.push(latestSetupLabels, label.new(bar_index + 1, lockedTp2, "TP2 · " + str.tostring(lockedTp2, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=color.green, textcolor=color.white, size=size.tiny))

if tp1Event or tp2Event or slEvent or ambiguousEvent
    if not na(statusEventLabel)
        label.delete(statusEventLabel)
    eventText = tp2Event ? "HIT TP 2" : tp1Event ? "HIT TP 1" : slEvent ? "HIT SL" : "AMBIGUOUS · CEK CANDLE"
    eventColor = tp2Event ? color.lime : tp1Event ? color.green : slEvent ? color.red : color.orange
    statusEventLabel := label.new(bar_index, setupSide == 1 ? high : low, eventText, xloc=xloc.bar_index, style=setupSide == 1 ? label.style_label_down : label.style_label_up, color=eventColor, textcolor=tp2Event ? color.black : color.white, size=size.small)

// Before the first setup, show a live analytical path. It may update with the
// still-forming market candle; confirmed setup paths above never repaint.
if barstate.islast and (setupStatus == 0 or setupStatus > 2 or setupStatus < 0) and showForecast
    if array.size(previewLines) > 0
        for i = 0 to array.size(previewLines) - 1
            line.delete(array.get(previewLines, i))
    array.clear(previewLines)
    prevX = bar_index + 1
    prevMid = close
    prevUpper = close
    prevLower = close
    for step = 1 to forecastBars
        nextMid = array.get(forecast, step - 1)
        nextUpper = array.get(forecastUpper, step - 1)
        nextLower = array.get(forecastLower, step - 1)
        nextX = bar_index + step + 1
        array.push(previewLines, line.new(prevX, prevMid, nextX, nextMid, xloc=xloc.bar_index, color=color.aqua, width=3))
        array.push(previewLines, line.new(prevX, prevUpper, nextX, nextUpper, xloc=xloc.bar_index, color=color.new(color.aqua, 58), style=line.style_dashed, width=1))
        array.push(previewLines, line.new(prevX, prevLower, nextX, nextLower, xloc=xloc.bar_index, color=color.new(color.aqua, 58), style=line.style_dashed, width=1))
        prevX := nextX
        prevMid := nextMid
        prevUpper := nextUpper
        prevLower := nextLower

displayEntry = setupStatus == 0 ? close : lockedEntry
displayStop = setupStatus == 0 ? close - forecastSide * stopDistance : lockedStop
displayTp1 = setupStatus == 0 ? close + forecastSide * math.abs(netMove) * 0.55 : lockedTp1
displayTp2 = setupStatus == 0 ? forecastTarget : lockedTp2
displayRR = setupStatus == 0 ? forecastRR : lockedRR

plot(emaSignal, "EMA 21", color=color.aqua, linewidth=2)
plot(emaSlow, "EMA 55", color=color.orange, linewidth=2)
// Setup drawings above intentionally show only the newest confirmed signal.

f_bias_text(value) => value > 0 ? "BULLISH" : value < 0 ? "BEARISH" : "NETRAL"
f_status_text(value) => value == 1 ? "OPEN" : value == 2 ? "TP1 HIT · LEVEL TETAP" : value == 3 ? "TP2 HIT" : value == -1 ? "SL HIT" : value == -2 ? "SL SETELAH TP1" : value == 4 ? "AMBIGUOUS · CEK CANDLE" : value == 5 ? "AMBIGUOUS SETELAH TP1" : value == 6 ? "EXPIRED" : value == 7 ? "EXPIRED SETELAH TP1" : "BELUM ADA SETUP"
var table dashboard = table.new(position.top_right, 2, 14, bgcolor=color.new(color.rgb(12, 18, 28), 8), frame_color=color.new(color.gray, 55), frame_width=1)

if barstate.islast
    if showDashboard
        header = color.rgb(14, 28, 44)
        labelBg = color.new(color.rgb(18, 27, 39), 4)
        valueBg = color.new(color.rgb(12, 20, 31), 2)
        table.cell(dashboard, 0, 0, "ARRA CRONOS", bgcolor=header, text_color=color.white, text_halign=text.align_left)
        table.cell(dashboard, 1, 0, "FORECAST · SIGNAL TERBARU", bgcolor=header, text_color=color.aqua, text_halign=text.align_right, text_size=size.tiny)
        table.cell(dashboard, 0, 1, "Simbol / timeframe", bgcolor=labelBg, text_color=color.silver, text_halign=text.align_left, text_size=size.tiny)
        table.cell(dashboard, 1, 1, syminfo.ticker + " · " + timeframe.period, bgcolor=valueBg, text_color=color.white, text_halign=text.align_right, text_size=size.tiny)
        table.cell(dashboard, 0, 2, "Timeframe sinyal", bgcolor=labelBg, text_color=color.silver, text_halign=text.align_left)
        table.cell(dashboard, 1, 2, "SEMUA TIMEFRAME", bgcolor=valueBg, text_color=color.lime, text_halign=text.align_right, text_size=size.tiny)
        table.cell(dashboard, 0, 3, "Bias chart / konfirmasi", bgcolor=labelBg, text_color=color.silver, text_halign=text.align_left, text_size=size.tiny)
        biasSummary = f_bias_text(chartBias) + " / " + (is15m ? "1H " + f_bias_text(confirmedHourBias) + " · 4H " + f_bias_text(confirmedFourHourBias) : is1h ? "4H " + f_bias_text(confirmedFourHourBias) + " · 1D " + f_bias_text(confirmedDailyBias) : is4h ? "1D " + f_bias_text(confirmedDailyBias) : is1d ? "4H " + f_bias_text(dailyFourHourBias) : hasHigherConfirmation ? confirmationTimeframe1 + " " + f_bias_text(genericFirstBias) + " · " + confirmationTimeframe2 + " " + f_bias_text(genericSecondBias) : "HTF N/A")
        table.cell(dashboard, 1, 3, biasSummary, bgcolor=valueBg, text_color=color.white, text_halign=text.align_right, text_size=size.tiny)
        table.cell(dashboard, 0, 4, "Trend score", bgcolor=labelBg, text_color=color.silver, text_halign=text.align_left)
        table.cell(dashboard, 1, 4, str.tostring(trendScore), bgcolor=valueBg, text_color=trendScore >= 15 ? color.lime : trendScore <= -15 ? color.red : color.silver, text_halign=text.align_right)
        table.cell(dashboard, 0, 5, "RSI " + str.tostring(rsiLength), bgcolor=labelBg, text_color=color.silver, text_halign=text.align_left)
        table.cell(dashboard, 1, 5, str.tostring(rsiValue, "#.0"), bgcolor=valueBg, text_color=color.white, text_halign=text.align_right)
        table.cell(dashboard, 0, 6, "ATR " + str.tostring(atrLength), bgcolor=labelBg, text_color=color.silver, text_halign=text.align_left)
        table.cell(dashboard, 1, 6, str.tostring(atrValue, format.mintick) + " · " + volatilityRegime, bgcolor=valueBg, text_color=color.white, text_halign=text.align_right, text_size=size.tiny)
        table.cell(dashboard, 0, 7, "STATUS SETUP", bgcolor=labelBg, text_color=color.silver, text_halign=text.align_left)
        table.cell(dashboard, 1, 7, f_status_text(setupStatus), bgcolor=valueBg, text_color=setupStatus == 1 or setupStatus == 2 ? color.lime : setupStatus < 0 ? color.red : color.white, text_halign=text.align_right, text_size=size.tiny)
        table.cell(dashboard, 0, 8, setupStatus == 0 ? "ENTRY · referensi" : "ENTRY · terkunci", bgcolor=labelBg, text_color=color.silver, text_halign=text.align_left, text_size=size.tiny)
        table.cell(dashboard, 1, 8, na(displayEntry) ? "—" : str.tostring(displayEntry, format.mintick), bgcolor=valueBg, text_color=color.aqua, text_halign=text.align_right)
        table.cell(dashboard, 0, 9, "STOP LOSS", bgcolor=labelBg, text_color=color.silver, text_halign=text.align_left, text_size=size.tiny)
        table.cell(dashboard, 1, 9, na(displayStop) ? "—" : str.tostring(displayStop, format.mintick), bgcolor=valueBg, text_color=color.red, text_halign=text.align_right)
        table.cell(dashboard, 0, 10, "TAKE PROFIT 1 / 2", bgcolor=labelBg, text_color=color.silver, text_halign=text.align_left, text_size=size.tiny)
        table.cell(dashboard, 1, 10, na(displayTp1) ? "—" : str.tostring(displayTp1, format.mintick) + " / " + str.tostring(displayTp2, format.mintick), bgcolor=valueBg, text_color=color.lime, text_halign=text.align_right, text_size=size.tiny)
        table.cell(dashboard, 0, 11, "RR skenario", bgcolor=labelBg, text_color=color.silver, text_halign=text.align_left, text_size=size.tiny)
        table.cell(dashboard, 1, 11, na(displayRR) ? "—" : "1:" + str.tostring(displayRR, "#.00"), bgcolor=valueBg, text_color=color.white, text_halign=text.align_right)
        table.cell(dashboard, 0, 12, "Target forecast", bgcolor=labelBg, text_color=color.silver, text_halign=text.align_left)
        table.cell(dashboard, 1, 12, na(displayTp2) ? str.tostring(forecastTarget, format.mintick) : str.tostring(displayTp2, format.mintick), bgcolor=valueBg, text_color=color.aqua, text_halign=text.align_right)
        table.cell(dashboard, 0, 13, "Catatan", bgcolor=labelBg, text_color=color.silver, text_halign=text.align_left)
        table.cell(dashboard, 1, 13, "Setup terbaru saja · candle tutup", bgcolor=valueBg, text_color=color.white, text_halign=text.align_right, text_size=size.tiny)
    else
        table.clear(dashboard, 0, 0, 1, 13)

    if setupStatus == 0 and showLevels
        if array.size(previewLevelLines) > 0
            for i = 0 to array.size(previewLevelLines) - 1
                line.delete(array.get(previewLevelLines, i))
        array.clear(previewLevelLines)
        array.push(previewLevelLines, line.new(bar_index, displayEntry, bar_index + 1, displayEntry, xloc=xloc.bar_index, extend=extend.right, color=color.new(color.blue, 25), style=line.style_dashed, width=2))
        array.push(previewLevelLines, line.new(bar_index, displayStop, bar_index + 1, displayStop, xloc=xloc.bar_index, extend=extend.right, color=color.new(color.red, 25), style=line.style_dashed, width=1))
        array.push(previewLevelLines, line.new(bar_index, displayTp1, bar_index + 1, displayTp1, xloc=xloc.bar_index, extend=extend.right, color=color.new(color.lime, 25), style=line.style_dashed, width=1))
        array.push(previewLevelLines, line.new(bar_index, displayTp2, bar_index + 1, displayTp2, xloc=xloc.bar_index, extend=extend.right, color=color.new(color.green, 25), style=line.style_dashed, width=2))
        if not na(previewEntryLabel)
            label.delete(previewEntryLabel)
        previewEntryLabel := label.new(bar_index + 1, displayEntry, "REFERENSI ENTRY · menunggu setup terkonfirmasi", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.blue, 20), textcolor=color.white, size=size.tiny)
    else if not na(previewEntryLabel)
        label.delete(previewEntryLabel)
        previewEntryLabel := na

alertcondition(openedBuy, title="ARRA Cronos BUY confirmed", message="ARRA Cronos BUY setup confirmed · TradingView feed · {{ticker}} · {{interval}} · {{close}}")
alertcondition(openedSell, title="ARRA Cronos SELL confirmed", message="ARRA Cronos SELL setup confirmed · TradingView feed · {{ticker}} · {{interval}} · {{close}}")
alertcondition(tp1Event, title="ARRA Cronos TP1 hit", message="ARRA Cronos TP1 touched · {{ticker}} · {{interval}} · {{close}}")
alertcondition(tp2Event, title="ARRA Cronos TP2 hit", message="ARRA Cronos TP2 hit · {{ticker}} · {{interval}} · {{close}}")
alertcondition(slEvent, title="ARRA Cronos SL hit", message="ARRA Cronos SL hit · {{ticker}} · {{interval}} · {{close}}")
alertcondition(ambiguousEvent, title="ARRA Cronos ambiguous candle", message="ARRA Cronos: candle touched both TP and SL; inspect OHLC sequence · {{ticker}} · {{interval}}")
