//@version=6
indicator("ARRA Cronos · Observed Market Readings", overlay=true)

fastLength = input.int(21, "EMA cepat", minval=2)
slowLength = input.int(55, "EMA lambat", minval=3)
rsiLength = input.int(14, "RSI", minval=2)
atrLength = input.int(14, "ATR", minval=2)
showDashboard = input.bool(true, "Tampilkan ringkasan")

fastEma = ta.ema(close, fastLength)
slowEma = ta.ema(close, slowLength)
rsiValue = ta.rsi(close, rsiLength)
atrValue = ta.atr(atrLength)

f_bias() =>
    fast = ta.ema(close, fastLength)
    slow = ta.ema(close, slowLength)
    fast > slow ? 1 : fast < slow ? -1 : 0

hourBias = request.security(syminfo.tickerid, "60", f_bias(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
fourHourBias = request.security(syminfo.tickerid, "240", f_bias(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
dailyBias = request.security(syminfo.tickerid, "D", f_bias(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
chartBias = fastEma > slowEma ? 1 : fastEma < slowEma ? -1 : 0

f_bias_text(value) => value > 0 ? "BULLISH" : value < 0 ? "BEARISH" : "NETRAL"
f_bias_color(value) => value > 0 ? color.lime : value < 0 ? color.red : color.silver

plot(fastEma, "EMA cepat", color=color.aqua, linewidth=2)
plot(slowEma, "EMA lambat", color=color.orange, linewidth=2)

var dashboard = table.new(position.top_right, 2, 8, bgcolor=color.new(color.rgb(12, 18, 28), 8), frame_color=color.new(color.gray, 55), frame_width=1)
if barstate.islast
    if showDashboard
        header = color.rgb(14, 28, 44)
        labelBg = color.new(color.rgb(18, 27, 39), 4)
        valueBg = color.new(color.rgb(12, 20, 31), 2)
        table.cell(dashboard, 0, 0, "ARRA CRONOS", bgcolor=header, text_color=color.white, text_halign=text.align_left)
        table.cell(dashboard, 1, 0, "DATA TERAMATI", bgcolor=header, text_color=color.aqua, text_halign=text.align_right, text_size=size.tiny)
        table.cell(dashboard, 0, 1, "Simbol / timeframe", bgcolor=labelBg, text_color=color.silver, text_halign=text.align_left, text_size=size.tiny)
        table.cell(dashboard, 1, 1, syminfo.ticker + " · " + timeframe.period, bgcolor=valueBg, text_color=color.white, text_halign=text.align_right, text_size=size.tiny)
        table.cell(dashboard, 0, 2, "Bias timeframe ini", bgcolor=labelBg, text_color=color.silver, text_halign=text.align_left)
        table.cell(dashboard, 1, 2, f_bias_text(chartBias), bgcolor=valueBg, text_color=f_bias_color(chartBias), text_halign=text.align_right)
        table.cell(dashboard, 0, 3, "RSI " + str.tostring(rsiLength), bgcolor=labelBg, text_color=color.silver, text_halign=text.align_left)
        table.cell(dashboard, 1, 3, str.tostring(rsiValue, "#.0"), bgcolor=valueBg, text_color=color.white, text_halign=text.align_right)
        table.cell(dashboard, 0, 4, "ATR " + str.tostring(atrLength), bgcolor=labelBg, text_color=color.silver, text_halign=text.align_left)
        table.cell(dashboard, 1, 4, str.tostring(atrValue, format.mintick), bgcolor=valueBg, text_color=color.white, text_halign=text.align_right)
        table.cell(dashboard, 0, 5, "EMA " + str.tostring(fastLength) + " / " + str.tostring(slowLength), bgcolor=labelBg, text_color=color.silver, text_halign=text.align_left)
        table.cell(dashboard, 1, 5, f_bias_text(chartBias), bgcolor=valueBg, text_color=f_bias_color(chartBias), text_halign=text.align_right)
        table.cell(dashboard, 0, 6, "Bias 1H / 4H", bgcolor=labelBg, text_color=color.silver, text_halign=text.align_left)
        table.cell(dashboard, 1, 6, f_bias_text(hourBias) + " / " + f_bias_text(fourHourBias), bgcolor=valueBg, text_color=f_bias_color(hourBias + fourHourBias), text_halign=text.align_right, text_size=size.tiny)
        table.cell(dashboard, 0, 7, "Bias harian", bgcolor=labelBg, text_color=color.silver, text_halign=text.align_left)
        table.cell(dashboard, 1, 7, f_bias_text(dailyBias), bgcolor=valueBg, text_color=f_bias_color(dailyBias), text_halign=text.align_right)
    else
        table.clear(dashboard, 0, 0, 1, 7)

alertcondition(barstate.isconfirmed and chartBias != chartBias[1], title="ARRA Cronos: bias berubah", message="Bias EMA ARRA Cronos berubah pada candle yang telah ditutup · {{ticker}} · {{interval}} · {{close}}")
