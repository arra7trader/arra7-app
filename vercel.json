{
    "builds": [
        {
            "src": "ml-backend/api/main.py",
            "use": "@vercel/python"
        },
        {
            "src": "package.json",
            "use": "@vercel/next"
        }
    ],
    "rewrites": [
        {
            "source": "/api/ml/:path*",
            "destination": "/ml-backend/api/main.py"
        }
    ]
}